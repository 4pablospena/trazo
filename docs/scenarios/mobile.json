{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": { "url": "https://excalidraw.com/" },
  "environment": {
    "viewport": { "width": 390, "height": 844, "device_scale_factor": 1 },
    "locale": "es-ES",
    "timezone": "Europe/Madrid",
    "color_scheme": "light"
  },
  "actions": [
    {
      "step_id": "mobile-editor-ready",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "canvas.excalidraw__canvas.interactive" },
      "state": "visible",
      "timeout_ms": 30000
    },
    { "step_id": "mobile-render", "action": "wait_for_timeout", "duration_ms": 1000 }
  ],
  "capture": {
    "at_end": ["screenshot", "dom", "accessibility", "url"],
    "events": ["page-errors"]
  }
}
