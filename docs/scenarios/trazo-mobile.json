{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:5173/"
  },
  "environment": {
    "viewport": {
      "width": 390,
      "height": 844,
      "device_scale_factor": 1
    },
    "locale": "es-ES",
    "timezone": "Europe/Madrid",
    "color_scheme": "light"
  },
  "actions": [
    {
      "step_id": "editor-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "canvas.excalidraw__canvas.interactive"
      },
      "state": "visible",
      "timeout_ms": 60000
    },
    {
      "step_id": "initial-render",
      "action": "wait_for_timeout",
      "duration_ms": 1500
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "page-errors",
      "console"
    ]
  }
}